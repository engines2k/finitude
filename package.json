{
  "name": "Finitude",
  "description": "Remove infinite scrolling from Youtube and limit feed sizes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt",
    "build": "wxt build -b firefox",
