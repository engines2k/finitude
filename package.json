    "zip:chrome": "wxt zip",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@wxt-dev/module-svelte": "^2.0.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.577.0",
    "tailwind-merge": "^3.5.0"
  }
